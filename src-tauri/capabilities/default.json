{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shared application capability for the main and live windows",
  "windows": ["main", "live"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "svelte:default",
    "global-shortcut:default",
    "opener:default",
    "opener:allow-open-url",
    "updater:default"
  ]
}
